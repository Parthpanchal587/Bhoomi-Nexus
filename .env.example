# ==============================================================================
# BHOOMI-NEXUS: Environment Configuration Template (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit actual secrets, private keys, or passwords to Git.
# - Copy this file to '.env' for local deployment and provide appropriate values.
# - In production/cloud deployments, configure secrets via your platform's secret
#   manager (e.g., Vercel Project Environment Variables, AWS Secrets Manager).
# ==============================================================================

# ── Server & Gateway Configuration ────────────────────────────────────────────
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=info

# ── CORS Configuration ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Do NOT use '*' with credentials in production.
CORS_ORIGINS="http://127.0.0.1:8000,http://localhost:8000,https://bhoomi-nexus.vercel.app"

# ── Secure Enclave (TEE Layer) Configuration ──────────────────────────────────
# Set isolation mode: "SOFTWARE_PROCESS_ISOLATED" (default) or "HARDWARE_BACKED_TEE" (when SGX/SEV is available)
ENCLAVE_ISOLATION_MODE=SOFTWARE_PROCESS_ISOLATED

# Optional master salt (Base64-encoded 32 bytes). If omitted, an ephemeral salt is generated at startup.
# ENCLAVE_MASTER_KEY_SALT=

# Maximum payload size in bytes accepted by the secure execution sandbox (default: 10485760 = 10 MB)
ENCLAVE_MAX_PAYLOAD_BYTES=10485760

# Maximum execution timeout in milliseconds for enclave operations (default: 8000 ms)
ENCLAVE_EXECUTION_TIMEOUT_MS=8000

# Optional append-only audit log file path
# ENCLAVE_AUDIT_LOG_PATH=logs/secure_audit.jsonl

# ── External AI Integration (Optional) ────────────────────────────────────────
# Google Gemini API key for live legal RAG analysis.
# Leave empty to use the built-in offline domain-specific heuristic synthesizer.
# GEMINI_API_KEY=

# ── Authentication & RBAC Configuration ───────────────────────────────────────
# Session token expiration in seconds (default: 86400 = 24 hours)
AUTH_SESSION_EXPIRY_SECONDS=86400
# Max failed login attempts before temporary account lockout (default: 5)
AUTH_MAX_FAILED_ATTEMPTS=5
# Account lockout duration in seconds (default: 900 = 15 minutes)
AUTH_LOCKOUT_DURATION_SECONDS=900

